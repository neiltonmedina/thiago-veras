# ============ Servidor ============
PORT=3000
# O Caddy (HTTPS) fica na frente; o backend só escuta localmente
HOST=127.0.0.1

# ============ Site (reservas) ============
# Endereços do site autorizados a chamar a API (separados por vírgula)
WEB_ORIGINS=https://thiagoverasempreendimentos.github.io

# ============ WhatsApp Cloud API (Meta) — OPCIONAL ============
# Deixe os quatro campos abaixo VAZIOS para usar só o site e o painel (sem agente no WhatsApp).
# Preencha os quatro juntos para ligar o agente.
# Passo a passo: README, seção "WhatsApp (Meta)"
# Token de acesso PERMANENTE (usuário do sistema), não o temporário de 24h
WHATSAPP_TOKEN=
# "Phone number ID" (não é o número de telefone) — painel da Meta → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=
# Uma senha qualquer que você inventa e repete no cadastro do webhook. Gere com: openssl rand -hex 16
WHATSAPP_VERIFY_TOKEN=
# App Secret — painel da Meta → Configurações do app → Básico
WHATSAPP_APP_SECRET=
# Template aprovado pra avisos ao atendente fora da janela de 24h (ex.: aviso_atendente).
# Vazio = avisos vão como texto livre (só chegam se o atendente falou com o bot nas últimas 24h).
WHATSAPP_SUPPORT_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=pt_BR

# ============ Google Gemini (IA da conversa) — OPCIONAL, só para o agente ============
# Crie em https://aistudio.google.com/apikey (grátis)
GEMINI_API_KEY=

# ============ Atendimento humano ============
# WhatsApp que recebe os alertas (55 + DDD + número)
SUPPORT_PHONE=5586999999999

# ============ Mídia das casas ============
# Endereço público HTTPS: a Meta baixa as fotos daqui pra mandar ao cliente
MEDIA_BASE_URL=https://SEU-DOMINIO/media

# ============ Banco de dados ============
DB_PATH=./data/thiago-veras.db

# ============ Painel /admin ============
# Sem senha, o painel fica desligado. Use uma senha longa.
ADMIN_USER=thiago
ADMIN_PASSWORD=

# ============ Pix automático (Efí) ============
# Sem esses campos, o bot cria a pré-reserva e o pagamento é combinado com o atendente.
DEPOSIT_PERCENT=50

# Tempo que as datas ficam seguras depois que o cliente finaliza, sem pagamento (minutos).
# Com o Thiago enviando o Pix na mão (sem Efí), use 120 (2 horas).
HOLD_MINUTES=120
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERT_PATH=./certs/efi-producao.p12
EFI_CERT_PASSWORD=
EFI_PIX_KEY=
EFI_SANDBOX=false
