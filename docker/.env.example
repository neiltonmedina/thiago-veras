# ============ Evolution API ============
# ATENÇÃO: essa chave é o "root" da Evolution — troque por algo forte antes de expor.
# É a mesma chave que vai em EVOLUTION_API_KEY no .env do backend.
AUTHENTICATION_API_KEY=troque-por-uma-chave-forte-com-32-caracteres

SERVER_URL=http://localhost:8080
LANGUAGE=pt-BR

# Banco (aponta pro serviço postgres do compose)
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:evolution_pass_change_me@postgres:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=evolution_exchange

# Cache Redis
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_PREFIX_KEY=thiagoveras

# Webhook global — deixamos configurar por instance no painel
WEBHOOK_GLOBAL_ENABLED=false

# Sessão
CONFIG_SESSION_PHONE_CLIENT=ThiagoVeras
CONFIG_SESSION_PHONE_NAME=chrome

# Logs
LOG_LEVEL=ERROR,WARN,INFO
LOG_COLOR=true

# QR Code
QRCODE_LIMIT=30

# Autenticação de instances
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true
