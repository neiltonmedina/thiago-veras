# Caddy cuida do HTTPS (certificado automático) e só deixa passar o necessário.
# O setup-vps.sh troca __DOMAIN__ pelo domínio (ou pelo IP com sslip.io).
__DOMAIN__ {
	# Site (API de reservas), Meta (webhook), fotos/vídeos e política de privacidade
	@public path /webhook/whatsapp /api/* /media/* /privacidade /admin /admin/* /health
	handle @public {
		reverse_proxy 127.0.0.1:3000
	}
	handle {
		respond 404
	}
}
