# ============ Servidor ============
PORT=3000

# ============ Evolution API (WhatsApp) ============
# URL da Evolution API. Se estiver rodando via Docker local: http://localhost:8080
EVOLUTION_API_URL=http://localhost:8080
# Chave definida em docker/.env (AUTHENTICATION_API_KEY)
EVOLUTION_API_KEY=troque-por-uma-chave-forte-com-32-caracteres
# Nome da instance criada no painel da Evolution
EVOLUTION_INSTANCE=anfitriao

# ============ Google Gemini (IA da conversa) ============
# Pegue em https://aistudio.google.com/apikey (grátis, 1500 req/dia)
GEMINI_API_KEY=cole-sua-chave-aqui

# ============ Repasse humano ============
# Número (formato 55 + DDD + celular) que recebe alerta quando cliente pede atendente
SUPPORT_PHONE=5586999999999

# ============ Storage de mídia ============
# URL base onde as fotos/vídeos das casas ficam servidos
# Em dev: http://localhost:3000/media  (o próprio backend serve /media)
# Em produção: https://seu-dominio.com/media  ou URL do Cloudinary/S3
MEDIA_BASE_URL=http://localhost:3000/media
