# ============ Servidor ============
PORT=3000

# ============ Evolution API (WhatsApp) ============
EVOLUTION_API_URL=http://localhost:8080
# Mesma chave de AUTHENTICATION_API_KEY em docker/.env
EVOLUTION_API_KEY=troque-por-uma-chave-forte-com-32-caracteres
EVOLUTION_INSTANCE=anfitriao
# Segredo exigido no webhook (?token=...). Gere com: openssl rand -hex 16
WEBHOOK_TOKEN=

# ============ Google Gemini (IA da conversa) ============
# Crie em https://aistudio.google.com/apikey (grátis)
GEMINI_API_KEY=cole-sua-chave-aqui

# ============ Atendimento humano ============
# WhatsApp que recebe os alertas (55 + DDD + número)
SUPPORT_PHONE=5586999999999

# ============ Mídia das casas ============
# O Evolution baixa as fotos daqui. Com tudo na mesma VM, use host.docker.internal.
MEDIA_BASE_URL=http://host.docker.internal:3000/media

# ============ Banco de dados ============
DB_PATH=./data/thiago-veras.db

# ============ Painel /admin ============
# Sem senha, o painel fica desligado. Use uma senha longa.
ADMIN_USER=thiago
ADMIN_PASSWORD=

# ============ Pix automático (Efí) ============
# Sem esses campos, o bot cria a pré-reserva e o pagamento é combinado com o atendente.
# Passo a passo pra obter as credenciais: README, seção "Pix (Efí)".
DEPOSIT_PERCENT=50
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERT_PATH=./certs/efi-producao.p12
EFI_CERT_PASSWORD=
EFI_PIX_KEY=
EFI_SANDBOX=false
