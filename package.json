{
  "name": "thiago-veras",
  "version": "0.1.0",
  "description": "Agente WhatsApp para gerenciar aluguel de casas de temporada no litoral do Piauí",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && cp src/houses/data.json dist/houses/data.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "simulate": "SIMULATE=1 tsx src/simulate.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
